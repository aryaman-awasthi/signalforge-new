# session/tooling files - never committed (CLAUDE.md rule 9)
CLAUDE.md
playbook/
.claude/

# python
__pycache__/
*.py[cod]
.venv/
.pytest_cache/

# node
node_modules/
.next/
web/out/

# runtime state, databases, local binaries
var/
*.db
*.db-journal
*.db-wal
*.db-shm
observability/bin/

# secrets and env. The template is committed - it is the config documentation
# and it carries no values; anything else matching .env* is a real environment.
.env
.env.*
!.env.example

# build output
dist/

# reference harness build and runtime state (the sources are committed, the jar is
# not). Globbed rather than named, because the core - this file included - may not
# name the reference application (CLAUDE.md rule 2).
reference-app/*/target/
reference-app/*/data/
reference-app/*/logs/

# TypeScript incremental build cache: a local artifact, not source.
web/tsconfig.tsbuildinfo

# Browser acceptance artefacts. The spec and its config are committed; traces,
# screenshots and console dumps from a run are not.
web/test-results/
web/playwright-report/
.playwright-mcp/
# The API's own log directory when it is started from the repository root.
/logs/
