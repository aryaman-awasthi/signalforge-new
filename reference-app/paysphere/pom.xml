<?xml version="1.0" encoding="UTF-8"?>
<!--
  PaySphere: the reference harness SignalForge onboards.

  This is demo data, not product (CLAUDE.md rule 7). It exists to prove one
  claim: an application that serves the frozen /observe contract and posts to
  the frozen /api/v1/ingest contract can be onboarded with no SignalForge code
  written for it. Nothing in signalforge/ knows this project exists.

  Dependencies are deliberately few. Spring Boot web + JDBC + H2 is everything
  the harness needs; Prometheus text exposition is produced by a small registry
  of its own (observe/MetricsRegistry.java) so the harness controls its output
  format exactly, which matters because the platform's parser refuses a
  malformed line rather than dropping it.
-->
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>org.springframework.boot</groupId>
    <artifactId>spring-boot-starter-parent</artifactId>
    <version>3.5.16</version>
    <relativePath/>
  </parent>

  <groupId>com.novapay</groupId>
  <artifactId>paysphere</artifactId>
  <version>1.0.0</version>
  <name>PaySphere reference harness</name>
  <description>Reference payments application onboarded into SignalForge through public contracts only</description>

  <properties>
    <java.version>17</java.version>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
  </properties>

  <dependencies>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-web</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-jdbc</artifactId>
    </dependency>
    <dependency>
      <groupId>com.h2database</groupId>
      <artifactId>h2</artifactId>
      <scope>runtime</scope>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-test</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <finalName>paysphere</finalName>
    <plugins>
      <plugin>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-maven-plugin</artifactId>
      </plugin>
    </plugins>
  </build>
</project>
