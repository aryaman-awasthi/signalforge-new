# SignalForge environment - COPY TO .env AND FILL IN. NEVER COMMIT A REAL KEY.
#
#   cp .env.example .env      # .env is gitignored; .env.example is not
#
# Every value here is optional: SignalForge boots with none of it set. Keys it
# needs and cannot invent (JWT signing, secret encryption) are generated once
# into var/keys/ on first run, and the model path degrades to its deterministic
# behaviour rather than refusing to start.

# --- the model path (REQ-051) ------------------------------------------------
# All AI traffic - chat *and* embeddings - leaves through the TCS GenAI Lab
# LiteLLM gateway. The host is an allowlist in code (signalforge/infrastructure/
# llm/hosts.py), not a preference: an endpoint outside it is refused and the
# platform runs deterministically instead of sending incident text elsewhere.
# Supply the base URL with or without the /v1 suffix; both normalise.
GENAILAB_BASE_URL=https://genailab.tcs.in/v1
GENAILAB_API_KEY=

# OPENAI_API_KEY is accepted as an alias so an existing local setup keeps
# working. GENAILAB_API_KEY wins, and the alias selects nothing: the endpoint is
# the gateway either way. OPENAI_BASE_URL and OPENAI_API_BASE are ignored.
# OPENAI_API_KEY=

# Model ids are configuration and are swappable for any approved model without
# a code change. A call site names a classification (general, reasoning,
# embeddings); these decide which model serves it.
#   general   : genailab-maas-gpt-5.4-mini | azure/genailab-maas-gpt-4.1-mini
#               | azure/genailab-maas-gpt-4o-mini
#   reasoning : genailab-maas-gpt-5.4 | genailab-maas-gpt-5.1 | gemini-2.5-pro
#               | azure_ai/genailab-maas-DeepSeek-R1
#   embeddings: azure/genailab-maas-text-embedding-3-large
LLM_MODEL_GENERAL=genailab-maas-gpt-5.4-mini
LLM_MODEL_REASONING=genailab-maas-gpt-5.4
LLM_MODEL_EMBEDDINGS=azure/genailab-maas-text-embedding-3-large

LLM_TIMEOUT_S=20
LLM_CACHE=true
# LLM_MAX_ATTEMPTS=3               # transient failures only; capped at 5
# LLM_INCIDENT_TOKEN_BUDGET=200000 # per incident, not per call
# LLM_PROMPT_VERSION=1             # bump to invalidate every cached answer

# TLS verification is always on. A corporate interception certificate is solved
# by presenting its CA bundle, never by disabling verification - there is no
# variable that does that.
# LLM_CA_BUNDLE=/path/to/corporate-ca-bundle.pem

# Verify the gateway before a demo (talks to the network; opt-in):
#   python scripts/llm_smoke.py
#   SIGNALFORGE_LIVE_LLM=1 python -m pytest signalforge/tests/llm -k live

# --- platform ----------------------------------------------------------------
# SIGNALFORGE_DB_URL=sqlite+aiosqlite:///var/signalforge.db
# SIGNALFORGE_ROLLUP_DB_URL=sqlite+aiosqlite:///var/rollups.db
# SIGNALFORGE_LOG_LEVEL=INFO
# SIGNALFORGE_WORKER_ENABLED=1
# SIGNALFORGE_DETECTION_ENABLED=1

# Generated into var/keys/ when unset. Set them in a real deployment; rotating
# the Fernet key without re-encrypting makes stored credentials unreadable.
# SIGNALFORGE_JWT_SECRET=
# SIGNALFORGE_FERNET_KEY=

# Security floors: configuration may only tighten these, never loosen them.
# SIGNALFORGE_ACCESS_TTL_S=900             # capped at 900
# SIGNALFORGE_SIGNAL_RETENTION_DAYS=7
# SIGNALFORGE_INGEST_REPLAY_WINDOW_S=300   # capped by the frozen contract
